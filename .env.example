SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ANTHROPIC_API_KEY=your-api-key-here

# El código de docente se gestiona por institución (Institution.teacher_code,
# editable desde el admin de Django), no como variable de entorno.

DB_NAME=cogniroom
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Email. Por defecto se imprime en consola (no envía de verdad). Para envío real
# vía Gmail: activá 2FA, generá una "Contraseña de aplicación" y descomentá:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion
# DEFAULT_FROM_EMAIL=CogniRoom <tu-correo@gmail.com>
